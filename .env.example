# Copy to .env only if you need to override something. Neither name below is
# required to run the pipeline or the tests, and neither carries a value here.

# The Blob write token. SPEC 8.9: it lives in exactly one place, a GitHub
# Actions secret of this name, and nothing else needs it. This laptop reads
# public URLs and cannot write. Never put the value in this file, in the
# repository, or in a chat.
BLOB_READ_WRITE_TOKEN=

# The public, read-only base URL of the store. SPEC 11.5: api/health and
# api/place fall back to config/store.json, which is committed, so this is
# only for pointing a preview deployment or a test at a different store.
# It is not a credential.
STORE_BASE_URL=
